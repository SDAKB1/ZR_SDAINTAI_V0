# Copy to .env for local testing only — never commit a real .env.
# On Cloud Foundry, set these with `cf set-env sdaintai-pipo-rfc-mcp <KEY> <VALUE>`
# then `cf restage sdaintai-pipo-rfc-mcp`, not via this file.

# Basic Auth users calling this MCP server — defaults match server.js if unset
MCP_USER_1=AYMANK
MCP_PASS_1=AYMANK
MCP_USER_2=SAIREDDY
MCP_PASS_2=SAIREDDY

# SDAINTAI target system (PI/PO) — fill in with real values when ready.
# Interim: can point at the same demo system as SDADATAAI's BW connection
# just to prove connectivity works, then swap to real PI/PO values later.
SDAINTAI_SAP_ASHOST=
SDAINTAI_SAP_SYSNR=00
SDAINTAI_SAP_CLIENT=
SDAINTAI_SAP_USER=
SDAINTAI_SAP_PASSWD=
SDAINTAI_SAP_LANG=EN
